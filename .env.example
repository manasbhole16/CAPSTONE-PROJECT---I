# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment Variables Template
# Capstone Project - I | Bluestock Mutual Fund Analytics
#
# Copy this file to .env and fill in actual values before running the project.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Path overrides (optional — defaults resolve to project root) ──────────────
# PROJECT_ROOT=/absolute/path/to/project        # Override project root
# DATA_DIR=/absolute/path/to/data               # Custom data directory
# REPORTS_DIR=/absolute/path/to/reports         # Custom reports directory
# DB_PATH=/absolute/path/to/bluestock_mf.db     # Custom SQLite DB path

# ── Analytics constants ────────────────────────────────────────────────────────
RISK_FREE_RATE=0.065          # Annual risk-free rate (RBI repo rate proxy)
TRADING_DAYS=252              # Trading days per year for annualisation
VAR_CONFIDENCE=0.95           # Historical VaR confidence level

# ── Recommender settings ───────────────────────────────────────────────────────
RECOMMENDER_TOP_N=3           # Number of funds returned by recommender

# ── Dashboard settings ────────────────────────────────────────────────────────
DASHBOARD_PORT=8501           # Port for Streamlit dashboard (if applicable)
DASHBOARD_HOST=0.0.0.0        # Host binding for cloud deployment

# ── Live NAV fetch ─────────────────────────────────────────────────────────────
# MFAPI_BASE_URL=https://api.mfapi.in/mf   # AMFI NAV API base URL (public, no auth)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
